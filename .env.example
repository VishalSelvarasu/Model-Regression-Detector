# Required. Get a free key at https://console.groq.com/keys
# (used for BOTH the classifier itself and the GEval judge model —
# see src/feature.py and src/groq_judge.py)
GROQ_API_KEY=your_groq_api_key_here

# Optional. Which prompt version under prompts/ to evaluate.
# Defaults to v1 if unset.
PROMPT_VERSION=v1

# Optional. Only needed if you enable Slack alerting in
# .github/workflows/eval.yml (commented out by default).
SLACK_WEBHOOK_URL=

# Optional. Set to YES to silence DeepEval's anonymous usage telemetry.
# DEEPEVAL_TELEMETRY_OPT_OUT=YES
